{
  "name": "dsh-model-logos",
  "version": "0.5.0",
  "description": "Shows each model's brand mark beside its name in the composer model selector and model picker, and vendor/model logos across Settings → Models, with a per-model icon picker.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model-icons",
    "model-logos",
    "vendor-logos"
  ],
  "homepage": "https://github.com/Altermoe/dsh-model-logos#readme",
  "bugs": {
    "url": "https://github.com/Altermoe/dsh-model-logos/issues"
  },
  "license": "MIT",
  "author": "Altermoe <kuroneko7520@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altermoe/dsh-model-logos.git"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "screenshots.json",
    "src",
    "scripts",
    "test",
    "reference",
    "docs",
    "README.md",
    "README.zh.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsx scripts/build.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "logo:check": "tsx scripts/import-logos.ts --check",
    "rank": "tsx scripts/rank-logos.ts --collect",
    "rank:check": "tsx scripts/rank-logos.ts --check",
    "preview": "tsx scripts/preview-logos.ts",
    "verify:dom": "tsx scripts/verify-dom.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run test && pnpm run logo:check && pnpm run rank:check && pnpm run build && pnpm run check",
    "prepublishOnly": "pnpm run verify",
    "prepare": "simple-git-hooks && pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,yml,yaml,md,css}": [
      "oxfmt --write"
    ]
  },
  "icon": "assets/icon-180.png",
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@12.16.1",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
