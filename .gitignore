# Dependencies
node_modules/

# Generated plugin artifacts. They are built into the package root because the
# local DSH install loads them from disk, but they are not source: never commit
# them. `pnpm install` / `pnpm run build` regenerates both.
client.js
index.js

# Build and verification scratch space (screenshots, headless-Edge profiles, reports)
.preview/

# Ranking/artwork fetch caches (the committed snapshots live in reference/)
.cache/

# Test and coverage output
coverage/
junit.xml

# Logs
*.log

# OS cruft
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local agent workspace data (session notes, not source or build input)
.workbuddy/

# pnpm-lock.yaml is committed: reproducible installs are a project invariant.
